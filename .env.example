# Optional process environment overrides; this file is documentation only.
# No dotenv loader is used. Generated local/config.json is the default.
# SAFESIGNAL_SENDER_TOKEN=<separate random sender token>
# SAFESIGNAL_RESPONDER_TOKEN=<separate random responder token>
# SAFESIGNAL_SESSION_SECRET=<random session signing secret>
# ENABLE_DEMO_FAULTS=0
# v2: human accounts use verified email/password; the above tokens are internal only.
# Real inbox delivery is required for public registration. No dotenv auto-loader.
# SAFESIGNAL_SMTP_HOST=<SMTP hostname supporting STARTTLS>
# SAFESIGNAL_SMTP_PORT=587
# SAFESIGNAL_MAIL_FROM=<authorized sender address>
# SAFESIGNAL_SMTP_USER=<SMTP username if required>
# SAFESIGNAL_SMTP_PASSWORD=<private SMTP password if required>
# Hosted registration stays off by default and by current owner decision.
# SAFESIGNAL_REGISTRATION_ENABLED=0
# Enable only after owner approval and genuine delivery verification.
